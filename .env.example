# SUPABASE CONFIGURATION TEMPLATE
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Hiện nút "Tiếp tục với Google / GitHub" ở trang đăng nhập.
# Chỉ bật sau khi đã bật đúng provider trong Supabase Dashboard
# (Authentication -> Providers) và khai redirect URL <origin>/auth,
# nếu không người dùng bấm vào chỉ nhận lỗi "provider is not enabled".
VITE_ENABLE_OAUTH=false

# TRỢ LÝ AI
# Không có biến nào ở đây cả — và đó là điều cố ý. Khoá Gemini nằm trong secret của
# Supabase, chỉ Edge Function `ai-insights` đọc được:
#
#   npx supabase secrets set GEMINI_API_KEY=khoá_từ_aistudio.google.com/apikey
#   npx supabase functions deploy ai-insights
#
# Xem supabase/README.md để biết các bước đầy đủ.
#
# Đặt khoá thành VITE_GEMINI_API_KEY là công khai nó: Vite nhúng mọi biến VITE_*
# thẳng vào bundle mà ai mở DevTools cũng đọc được.
