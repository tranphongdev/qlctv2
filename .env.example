# SUPABASE CONFIGURATION TEMPLATE
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Hiện nút "Tiếp tục với Google / GitHub" ở trang đăng nhập.
# Chỉ bật sau khi đã bật đúng provider trong Supabase Dashboard
# (Authentication -> Providers) và khai redirect URL <origin>/auth,
# nếu không người dùng bấm vào chỉ nhận lỗi "provider is not enabled".
VITE_ENABLE_OAUTH=false
